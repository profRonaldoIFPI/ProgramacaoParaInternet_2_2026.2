<%- include('partials/header') %>

<section class="max-w-lg mx-auto bg-white rounded-xl shadow-sm border border-slate-200 p-6 md:p-8" aria-labelledby="form-titulo">
  <header class="mb-6">
    <hgroup>
      <h1 id="form-titulo" class="text-2xl font-bold text-slate-800">Nova Tarefa</h1>
      <p class="text-sm text-slate-500">Adicione uma nova tarefa à sua lista de afazeres</p>
    </hgroup>
  </header>

  <form action="/tarefas/nova" method="post" class="space-y-5">
    <fieldset class="space-y-1">
      <label for="descricao" class="block text-sm font-medium text-slate-700">
        Descrição da Tarefa
      </label>
      <input 
        type="text" 
        id="descricao" 
        name="descricao" 
        required 
        placeholder="Ex: Estudar Rotas no Express..." 
        class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-slate-800 placeholder-slate-400 transition"
      />
      <input type="hidden" name="status" value="Pendente" />
    </fieldset>

    <menu class="flex items-center justify-end gap-3 pt-2 p-0 m-0">
      <li>
        <a 
          href="/tarefas" 
          class="inline-block px-4 py-2 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-100 transition"
        >
          Cancelar
        </a>
      </li>
      <li>
        <button 
          type="submit" 
          class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-5 py-2.5 rounded-lg shadow-sm transition cursor-pointer"
        >
          Salvar Tarefa
        </button>
      </li>
    </menu>
  </form>
</section>

<%- include('partials/footer') %>
