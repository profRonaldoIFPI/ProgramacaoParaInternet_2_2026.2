<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <title>Aula 1 EJS</title>
  </head>
  <body>
    <h1>Cadastro</h1>
    <form method="post" action="/cadastro">
      <label for="nome">Nome:</label>
